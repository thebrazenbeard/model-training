    "UNKNOWN_TRANSPORT_OUTCOME",
    "NONUNIQUE_ROUTE",
    "MISSING_DURABLE_RESULT",
    "UNAUTHORIZED_MEMORY_ADMISSION"
  ],
  "forbidden_promotions": [
    "source_to_truth",
    "source_to_installation",
    "installation_to_route",
    "route_to_effect",
    "model_text_to_completion",
    "critique_to_authentication",
    "initiative_to_consent",
    "memory_proposal_to_memory",
    "GGUF_to_loaded_model",
    "project_chat_to_runtime"
  ],
  "measured_source_evaluations": [
